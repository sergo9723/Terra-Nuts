# Порт сайта
PORT=3000

# Токены ботов — получить у @BotFather (см. README, раздел "Создание ботов")
CUSTOMER_BOT_TOKEN=
ADMIN_BOT_TOKEN=

# Username клиентского бота без @ (например TerraNutsOrderBot) — нужен для кнопки
# "Заказать" на сайте (ссылка вида https://t.me/<username>?start=...)
CUSTOMER_BOT_USERNAME=

# Telegram chat_id админа — куда будут приходить заявки.
# Проще всего: написать /start админ-боту, затем открыть
# https://api.telegram.org/bot<ADMIN_BOT_TOKEN>/getUpdates и взять "chat":{"id": ...}
ADMIN_CHAT_ID=

# Публичный адрес сайта (для ссылок в сообщениях бота). Пока без домена — впишите
# адрес, который выдаст Cloudflare Tunnel (см. README).
SITE_URL=http://localhost:3000
